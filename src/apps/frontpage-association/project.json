{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "frontpage-association",
  "projectType": "application",
  "metadata": {
    "ci": {
      "npm": true
    }
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "src/apps/frontpage-association",
        "command": "npm run build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "outputs": [],
      "options": {
        "cwd": "src/apps/frontpage-association",
        "command": "npm test -- --watch=false && npm run check:hosting"
      }
    }
  }
}
