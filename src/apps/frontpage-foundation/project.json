{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "frontpage-foundation",
  "projectType": "application",
  "metadata": {
    "ci": {
      "npm": true
    }
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist/frontpage-foundation"
      ],
      "options": {
        "cwd": "src/apps/frontpage-foundation",
        "command": "npm run build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "cwd": "src/apps/frontpage-foundation",
        "command": "npm test -- --watch=false && npm run check:hosting"
      },
      "dependsOn": [
        "build"
      ]
    }
  }
}
