{
  "name": "frontpage-foundation",
  "version": "0.0.2",
  "scripts": {
    "ng": "ng",
    "start": "node ../../../eng/frontend.mjs serve --booking-turnstile",
    "build": "node ../../../eng/frontend.mjs build --booking-turnstile",
    "watch": "node ../../../eng/frontend.mjs build --booking-turnstile --watch --configuration development",
    "test": "ng test",
    "preview": "npm run build && npm run check:hosting && wrangler dev",
    "deploy": "npm run build && npm run check:hosting && wrangler deploy",
    "check:hosting": "node ../../../eng/static-hosting.mjs check"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^22.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "4.160.0"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": "11.19.1"
  }
}
