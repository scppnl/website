{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "contact-api",
  "projectType": "application",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/**/bin/**/*",
      "!{projectRoot}/**/obj/**/*",
      "!{projectRoot}/**/TestResults/**/*",
      "{workspaceRoot}/Scpp.slnx",
      "sharedGlobals"
    ]
  },
  "targets": {
    "restore": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node eng/dotnet.mjs restore src/shared/contact-api/Scpp.Shared.Contact.slnx"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["restore"],
      "options": {
        "command": "node eng/dotnet.mjs build src/shared/contact-api/Scpp.Shared.Contact.slnx"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node eng/dotnet.mjs test src/shared/contact-api/Scpp.Shared.Contact.slnx"
      }
    }
  }
}
